SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
APP_URL=https://your-production-domain.example

# Optional demo account credentials (defaults to demo@homefinance.app / HomeFinanceDemo1!)
DEMO_ACCOUNT_EMAIL=demo@homefinance.app
DEMO_ACCOUNT_PASSWORD=HomeFinanceDemo1!

# Optional. Leave empty to use the current localhost origin while developing.
LOCAL_APP_URL=

# Supported aliases for deployment providers:
# PUBLIC_SUPABASE_URL, VITE_SUPABASE_URL, NG_APP_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_PUBLISHABLE_KEY, PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_PUBLISHABLE_KEY, NG_APP_SUPABASE_ANON_KEY,
# NEXT_PUBLIC_SUPABASE_ANON_KEY
# PUBLIC_APP_URL, VITE_APP_URL, NG_APP_URL, NEXT_PUBLIC_APP_URL, VERCEL_PROJECT_PRODUCTION_URL